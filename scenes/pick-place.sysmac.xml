        <MainBody>
          <BodyContent xsi:type="ST">
            <ST>// Generated by manufacturing_io tools/gen_sysmac.js from scenes/pick-place.st. Edit the .st, then regenerate.

// Heartbeat: the plant says &quot;program not running or not assigned to a task&quot; when this stops.
MIO_HEARTBEAT := MIO_HEARTBEAT + 1;

// pick-place: feed a part into the pick nest, pick it with the vacuum cup on the lift cylinder,
// traverse on the servo, lay it on the running outfeed belt, and come home while the belt takes
// it to the unloader. Repeat until STOP. The same sequence runs without a PLC in
// pick-place.ctl.js.
//
// Two handshakes matter. The servo's Execute is a LEVEL held until Done, and Done must be seen
// to drop before the next Execute. The nest clamp must open BEFORE the cup can take the part:
// one part is held by one holder.
//
// Waiting steps wait for an INVARIANT, not for a counter to move: a change cannot say which
// part moved (measured on a-to-b against the simulator: parts piled up, then pipelined).
//
// The panel has a selector AUTO / INDIVIDUAL: START only in AUTO, the individual buttons only in
// INDIVIDUAL, and a change while the sequence runs is a FAULT, not a pause.

START_EDGE := PB_START AND NOT PB_START_LAST;
PB_START_LAST := PB_START;
IF PB_CSTOP THEN
	STOP_REQ := TRUE;
END_IF;
SEL_CHANGED := SEL_AUTO &lt;&gt; SEL_LAST;
SEL_LAST := SEL_AUTO;

// The master circuit, as on the cell panel: E-STOP is a latching mushroom, MASTER ON energises
// the machine, and nothing runs without it. An E-STOP also loses the home position.
ESTOP := PB_ESTOP;
MASTER_EDGE := PB_MASTER AND NOT PB_MASTER_LAST;
PB_MASTER_LAST := PB_MASTER;
HOME_EDGE := PB_HOME AND NOT PB_HOME_LAST;
PB_HOME_LAST := PB_HOME;
IF ESTOP THEN
	MASTER_ON := FALSE;
	HOMED := FALSE;
ELSIF MASTER_EDGE THEN
	MASTER_ON := TRUE;
END_IF;
READY := MASTER_ON AND NOT ESTOP;

CASE ST1_STEP OF
	0:	// idle
		CV_RUN := FALSE;
		EM_EMIT := FALSE;
		VAC_ON := FALSE;
		SOL_Z_DN := FALSE;
		SOL_Z_UP := TRUE;
		SV_EXEC := FALSE;
		IF START_EDGE AND SEL_AUTO AND READY AND HOMED AND AS_Z_UP AND SV_INPOS AND NOT SV_DONE THEN
			STOP_REQ := FALSE;
			EM_LAST := EM_CNT;
			ST1_STEP := 10;
		END_IF;
	10:	// belt on, feed one part
		CV_RUN := TRUE;
		CLAMP_A := TRUE;
		EM_EMIT := TRUE;
		IF EM_CNT &lt;&gt; EM_LAST THEN
			EM_EMIT := FALSE;
			ST1_STEP := 20;
		END_IF;
	20:	// the nest reports the part
		IF NEST_A_P THEN
			ST1_STEP := 30;
		END_IF;
	30:	// lift down onto the part
		SOL_Z_UP := FALSE;
		SOL_Z_DN := TRUE;
		IF AS_Z_DN THEN
			ST1_STEP := 40;
		END_IF;
	40:	// nest lets go, vacuum takes over
		CLAMP_A := FALSE;
		VAC_ON := TRUE;
		IF VAC_SW THEN
			ST1_STEP := 50;
		END_IF;
	50:	// lift up with the part
		SOL_Z_DN := FALSE;
		SOL_Z_UP := TRUE;
		IF AS_Z_UP THEN
			ST1_STEP := 60;
		END_IF;
	60:	// traverse to the belt
		SV_TGT := 600.0;
		SV_EXEC := TRUE;
		IF SV_DONE THEN
			SV_EXEC := FALSE;
			ST1_STEP := 70;
		END_IF;
	70:	// wait until the plant has seen Execute drop
		IF NOT SV_DONE THEN
			ST1_STEP := 80;
		END_IF;
	80:	// lift down over the belt
		SOL_Z_UP := FALSE;
		SOL_Z_DN := TRUE;
		IF AS_Z_DN THEN
			ST1_STEP := 90;
		END_IF;
	90:	// let the part go onto the belt
		VAC_ON := FALSE;
		IF NOT VAC_SW THEN
			ST1_STEP := 100;
		END_IF;
	100:	// lift up
		SOL_Z_DN := FALSE;
		SOL_Z_UP := TRUE;
		IF AS_Z_UP THEN
			ST1_STEP := 110;
		END_IF;
	110:	// traverse home
		SV_TGT := 0.0;
		SV_EXEC := TRUE;
		IF SV_DONE THEN
			SV_EXEC := FALSE;
			ST1_STEP := 120;
		END_IF;
	120:	// wait until the plant has seen Execute drop
		IF NOT SV_DONE THEN
			ST1_STEP := 130;
		END_IF;
	130:	// the belt carries the part to the unloader: everything loaded must have left
		IF RM_CNT + GONE &gt;= EM_CNT THEN
			CYCLE_CNT := CYCLE_CNT + 1;
			IF STOP_REQ THEN
				ST1_STEP := 0;
			ELSE
				EM_LAST := EM_CNT;
				ST1_STEP := 10;
			END_IF;
		END_IF;
	800:	// HOME: lift up and traverse home. The cup is left alone: a real machine does not drop the part it holds
		CV_RUN := FALSE;
		EM_EMIT := FALSE;
		SOL_Z_DN := FALSE;
		SOL_Z_UP := TRUE;
		SV_TGT := 0.0;
		SV_EXEC := TRUE;
		IF AS_Z_UP AND SV_DONE THEN
			SV_EXEC := FALSE;
			HOMED := TRUE;
			ST1_STEP := 0;
		END_IF;
	910:	// E-STOP: the master circuit is open, so every solenoid de-energises - which is what
		// really happens: a 5/2 single-solenoid valve springs back, a double one holds. The holders keep their parts: a real machine does not let go when the power drops.
		EM_EMIT := FALSE;
		SV_EXEC := FALSE;
		SOL_Z_DN := FALSE;
		SOL_Z_UP := FALSE;
		CV_RUN := FALSE;
		IF READY THEN	// MASTER ON after the mushroom is released
			ST1_STEP := 0;
		END_IF;
	900:	// FAULT: a step stopped moving, or the selector was turned while running. Stop feeding
		// and the servo, but KEEP vacuum: a real machine does not drop the part it is holding.
		EM_EMIT := FALSE;
		CV_RUN := FALSE;
		SV_EXEC := FALSE;
		IF START_EDGE AND SEL_AUTO THEN
			STOP_REQ := FALSE;
			// Acknowledging writes off whatever never reached the unloader. Only HERE: at every
			// START it would write off parts still legitimately in the machine, and then an older
			// part's removal ends this cycle - the pipelining bug that cost two live rounds.
			GONE := EM_CNT - RM_CNT;
			ST1_STEP := 0;
		END_IF;
END_CASE;

// Watchdog: a running step that stops moving is a jam, not patience. Measured before this existed:
// taking the part out of the nest left ST1_STEP at 20 indefinitely with AUTO_RUN still on. A
// selector change while running trips the same way.
T_WD(In := (ST1_STEP = STEP_LAST) AND (ST1_STEP &lt;&gt; 0) AND (ST1_STEP &lt;&gt; 900) AND (ST1_STEP &lt;&gt; 910), PT := T#15s);
IF ST1_STEP &lt;&gt; STEP_LAST THEN
	STEP_LAST := ST1_STEP;
END_IF;
IF T_WD.Q OR (SEL_CHANGED AND (ST1_STEP &lt;&gt; 0) AND (ST1_STEP &lt;&gt; 900) AND (ST1_STEP &lt;&gt; 910)) THEN
	ST1_STEP := 900;
	EM_EMIT := FALSE;
	CV_RUN := FALSE;
	SV_EXEC := FALSE;
END_IF;

// E-STOP at any moment, and the HOME button when the machine is energised and idle.
IF ESTOP THEN
	IF ST1_STEP &lt;&gt; 910 THEN
		ST1_STEP := 910;
	END_IF;
	EM_EMIT := FALSE;
	SV_EXEC := FALSE;
	SOL_Z_DN := FALSE;
	SOL_Z_UP := FALSE;
	CV_RUN := FALSE;
ELSIF HOME_EDGE AND READY AND (ST1_STEP = 0) THEN
	ST1_STEP := 800;
END_IF;

AUTO_RUN := (ST1_STEP &lt;&gt; 0) AND (ST1_STEP &lt;&gt; 800) AND (ST1_STEP &lt;&gt; 900) AND (ST1_STEP &lt;&gt; 910);

// Individual operation: momentary buttons, a PLC toggle memory per actuator, cleared when INDIVIDUAL
// ends. The servo buttons are held: Execute is a level, and the axis finishes the move on its own.
IF NOT SEL_AUTO AND NOT AUTO_RUN AND READY AND (ST1_STEP &lt;&gt; 800) THEN
	IF IND_CV AND NOT IND_CV_LAST THEN
		MEM_CV := NOT MEM_CV;
	END_IF;
	IF IND_CLAMP AND NOT IND_CLAMP_LAST THEN
		MEM_CLAMP := NOT MEM_CLAMP;
	END_IF;
	IF IND_LIFT AND NOT IND_LIFT_LAST THEN
		MEM_LIFT := NOT MEM_LIFT;
	END_IF;
	IF IND_VAC AND NOT IND_VAC_LAST THEN
		MEM_VAC := NOT MEM_VAC;
	END_IF;
	CV_RUN := MEM_CV;
	EM_EMIT := IND_FEED;
	CLAMP_A := MEM_CLAMP;
	SOL_Z_DN := MEM_LIFT;
	SOL_Z_UP := NOT MEM_LIFT;
	VAC_ON := MEM_VAC;
ELSE
	MEM_CV := FALSE;
	MEM_CLAMP := FALSE;
	MEM_LIFT := FALSE;
	MEM_VAC := FALSE;
END_IF;
IND_CV_LAST := IND_CV;
IND_CLAMP_LAST := IND_CLAMP;
IND_LIFT_LAST := IND_LIFT;
IND_VAC_LAST := IND_VAC;

// The speed override the operator dialled in, passed on to the axes and the belts.
OVR := OVR_SET;

// Jog: the axis creeps while the button is held, and only on INDIVIDUAL.
SV_JOG_P := NOT SEL_AUTO AND NOT AUTO_RUN AND READY AND (ST1_STEP &lt;&gt; 800) AND IND_SV_P;
SV_JOG_N := NOT SEL_AUTO AND NOT AUTO_RUN AND READY AND (ST1_STEP &lt;&gt; 800) AND IND_SV_N;

PL_START := AUTO_RUN;
PL_MASTER := MASTER_ON;
PL_HOME := HOMED;</ST>
          </BodyContent>
        </MainBody>
      </Program>
