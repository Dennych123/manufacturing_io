{
  "format": "mio-scene/1",
  "name": "cyl-on-slide",
  "sim": { "dtMs": 2 },
  "io": {
    "driver": "opcua",
    "endpoint": "opc.tcp://127.0.0.1:4840",
    "prefix": "GlobalVars.",
    "mode": "sim",
    "minPulseMs": 20
  },
  "stations": [
    {
      "id": "ST1",
      "name": "Press",
      "members": ["slide1", "bracket", "cyl1"],
      "stepTag": "ST1_STEP"
    }
  ],
  "cycle": {
    "exitTag": "AS_ST1_PRSS_CYL_UP",
    "autoTag": "AUTO_RUN",
    "countTag": "CYCLE_CNT",
    "exclude": 1,
    "avgN": 10
  },
  "components": [
    { "id": "base", "type": "frame", "params": { "size": [1000, 600, 800] } },
    {
      "id": "slide1",
      "type": "servoLinear",
      "label": "PRESS SLIDE",
      "station": "ST1",
      "parent": "base",
      "socket": "top",
      "at": [0, -100, 0],
      "params": { "mode": "plant", "stroke": 500, "vmax": 300, "acc": 1500, "body": [640, 90, 70] },
      "io": {
        "target": "SV1_TGT",
        "exec": "SV1_EXEC",
        "done": "SV1_DONE",
        "actPos": "SV1_ACT_POS",
        "inPos": "SV1_INPOS",
        "ovr": "OVR",
        "jogP": "SV1_JOG_P",
        "jogN": "SV1_JOG_N"
      }
    },
    {
      "id": "bracket",
      "type": "plate",
      "station": "ST1",
      "parent": "slide1",
      "socket": "carriage",
      "at": [0, -56, 0],
      "params": { "size": [100, 12, 250] }
    },
    {
      "id": "cyl1",
      "type": "cylinder",
      "label": "PRESS CYLINDER",
      "station": "ST1",
      "parent": "bracket",
      "socket": "top",
      "at": [0, -30, 0],
      "rot": [180, 0, 0],
      "params": {
        "bore": 32,
        "stroke": 100,
        "valve": "5/2-double",
        "extendMs": 450,
        "retractMs": 380,
        "cushionMm": 8,
        "valveMs": 15,
        "extWord": "DOWN",
        "retWord": "UP",
        "switches": [{ "id": "ret", "pos": 2 }, { "id": "ext", "pos": 97 }]
      },
      "io": {
        "solExt": "SOL_ST1_PRSS_CYL_DN",
        "solRet": "SOL_ST1_PRSS_CYL_UP",
        "sw.ret": "AS_ST1_PRSS_CYL_UP",
        "sw.ext": "AS_ST1_PRSS_CYL_DN"
      }
    },
    {
      "id": "part1",
      "type": "workpiece",
      "parent": "base",
      "socket": "top",
      "at": [150, -186, 0],
      "params": { "kind": "box", "size": [80, 60, 40] }
    },
    { "id": "sel", "type": "selector", "label": "AUTO / INDIVIDUAL", "io": { "sel": "SEL_AUTO" } },
    {
      "id": "pbMaster",
      "type": "pushbutton",
      "label": "MASTER ON",
      "params": { "kind": "momentary", "color": "white", "lamp": true },
      "io": { "pb": "PB_MASTER", "lamp": "PL_MASTER" }
    },
    {
      "id": "pbEstop",
      "type": "pushbutton",
      "label": "EMERGENCY STOP",
      "params": { "kind": "alternate", "color": "red", "lamp": false },
      "io": { "pb": "PB_ESTOP" }
    },
    {
      "id": "pbStart",
      "type": "pushbutton",
      "label": "START",
      "params": { "kind": "momentary", "color": "green", "lamp": true },
      "io": { "pb": "PB_START", "lamp": "PL_START" }
    },
    {
      "id": "pbCstop",
      "type": "pushbutton",
      "label": "CYCLE STOP",
      "params": { "kind": "momentary", "color": "yellow", "lamp": false },
      "io": { "pb": "PB_CSTOP" }
    },
    {
      "id": "pbHome",
      "type": "pushbutton",
      "label": "HOME POS",
      "params": { "kind": "momentary", "color": "blue", "lamp": true },
      "io": { "pb": "PB_HOME", "lamp": "PL_HOME" }
    },
    {
      "id": "lampAuto",
      "type": "lamp",
      "label": "AUTO",
      "params": { "color": "amber" },
      "io": { "lamp": "AUTO_RUN" }
    },
    {
      "id": "dialOvr",
      "type": "speedDial",
      "label": "SPEED",
      "params": { "min": 10 },
      "io": { "ovr": "OVR_SET" }
    },
    {
      "id": "pbIndCyl",
      "type": "pushbutton",
      "label": "IND PRESS CYL",
      "params": { "kind": "momentary", "color": "white", "lamp": true },
      "io": { "pb": "IND_CYL", "lamp": "SOL_ST1_PRSS_CYL_DN" }
    },
    {
      "id": "pbJogSV1P",
      "type": "pushbutton",
      "label": "JOG SLIDE +",
      "params": { "kind": "momentary", "color": "amber", "lamp": true },
      "io": { "pb": "IND_SV1_P", "lamp": "SV1_JOG_P" }
    },
    {
      "id": "pbJogSV1N",
      "type": "pushbutton",
      "label": "JOG SLIDE -",
      "params": { "kind": "momentary", "color": "amber", "lamp": true },
      "io": { "pb": "IND_SV1_N", "lamp": "SV1_JOG_N" }
    }
  ]
}
