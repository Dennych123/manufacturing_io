{
  "format": "mio-scene/1",
  "name": "gripper-transfer",
  "sim": { "dtMs": 2 },
  "io": {
    "driver": "opcua",
    "endpoint": "opc.tcp://127.0.0.1:4840",
    "prefix": "GlobalVars.",
    "mode": "sim",
    "minPulseMs": 20
  },
  "stations": [
    {
      "id": "ST1",
      "name": "Gripper transfer",
      "members": ["cv1", "pe1", "axY", "axZ", "grip1", "cv2"],
      "stepTag": "ST1_STEP"
    }
  ],
  "cycle": {
    "exitTag": "AS_Y_IN",
    "autoTag": "AUTO_RUN",
    "countTag": "CYCLE_CNT",
    "exclude": 1,
    "avgN": 10
  },
  "components": [
    {
      "id": "cv1",
      "type": "conveyor",
      "label": "INFEED BELT",
      "station": "ST1",
      "params": { "length": 1200, "width": 200, "height": 800, "speed": 300, "guides": 0 },
      "io": { "run": "CV1_RUN", "ovr": "OVR" }
    },
    {
      "id": "wp",
      "type": "workpiece",
      "label": "PART TEMPLATE",
      "at": [0, 900, 0],
      "params": { "size": [60, 40, 30], "color": "#f2c21b", "material": "alu" }
    },
    {
      "id": "em1",
      "type": "emitter",
      "label": "LOADER",
      "parent": "cv1",
      "socket": "start",
      "at": [80, 0, 50],
      "params": { "template": "wp", "mode": "tag" },
      "io": { "emit": "EM_EMIT", "count": "EM_CNT" }
    },
    {
      "id": "pe1",
      "type": "photoEye",
      "label": "PICK SENSOR",
      "station": "ST1",
      "parent": "cv1",
      "socket": "end",
      "at": [-120, -140, 15],
      "rot": [0, 0, 90],
      "params": { "range": 300 },
      "io": { "out": "PE_PICK" }
    },
    {
      "id": "post",
      "type": "plate",
      "label": "COLUMN",
      "at": [465, 440, 0],
      "params": { "size": [60, 60, 1204] }
    },
    {
      "id": "axY",
      "type": "cylinder",
      "label": "TRAVERSE",
      "station": "ST1",
      "at": [465, 479, 1225],
      "rot": [90, 0, 0],
      "params": {
        "bore": 32,
        "stroke": 400,
        "valve": "5/2-double",
        "extendMs": 900,
        "retractMs": 800,
        "extWord": "OUT",
        "retWord": "IN"
      },
      "io": {
        "solExt": "SOL_Y_OUT",
        "solRet": "SOL_Y_IN",
        "sw.ret": "AS_Y_IN",
        "sw.ext": "AS_Y_OUT"
      }
    },
    {
      "id": "axZ",
      "type": "cylinder",
      "label": "LIFT",
      "station": "ST1",
      "parent": "axY",
      "socket": "rodEnd",
      "at": [0, 0, 0],
      "rot": [90, 0, 0],
      "params": {
        "bore": 25,
        "stroke": 150,
        "valve": "5/2-double",
        "extendMs": 400,
        "retractMs": 400,
        "extWord": "DOWN",
        "retWord": "UP"
      },
      "io": { "solExt": "SOL_Z_DN", "solRet": "SOL_Z_UP", "sw.ret": "AS_Z_UP", "sw.ext": "AS_Z_DN" }
    },
    {
      "id": "grip1",
      "type": "gripper",
      "label": "GRIPPER",
      "station": "ST1",
      "parent": "axZ",
      "socket": "rodEnd",
      "at": [0, 0, 0],
      "params": { "span": 60, "fingerLen": 50, "fingerW": 12, "closeMs": 250, "openMs": 250 },
      "io": { "close": "GRIP_CLOSE", "open": "GRIP_OPEN", "closed": "GRIP_CLOSED" }
    },
    {
      "id": "cv2",
      "type": "conveyor",
      "label": "OUTFEED BELT",
      "station": "ST1",
      "at": [465, -850, 0],
      "rot": [0, 0, -90],
      "params": { "length": 1000, "width": 200, "height": 800, "speed": 300, "guides": 0 },
      "io": { "run": "CV2_RUN", "ovr": "OVR" }
    },
    {
      "id": "rm1",
      "type": "remover",
      "label": "OUTFEED",
      "parent": "cv2",
      "socket": "end",
      "at": [-60, 0, 0],
      "params": { "size": [120, 260, 200] },
      "io": { "count": "RM_CNT" }
    },
    { "id": "sel", "type": "selector", "label": "AUTO / INDIVIDUAL", "io": { "sel": "SEL_AUTO" } },
    {
      "id": "pbMaster",
      "type": "pushbutton",
      "label": "MASTER ON",
      "params": { "kind": "momentary", "color": "white", "lamp": true },
      "io": { "pb": "PB_MASTER", "lamp": "PL_MASTER" }
    },
    {
      "id": "pbEstop",
      "type": "pushbutton",
      "label": "EMERGENCY STOP",
      "params": { "kind": "alternate", "color": "red", "lamp": false },
      "io": { "pb": "PB_ESTOP" }
    },
    {
      "id": "pbStart",
      "type": "pushbutton",
      "label": "START",
      "params": { "kind": "momentary", "color": "green", "lamp": true },
      "io": { "pb": "PB_START", "lamp": "PL_START" }
    },
    {
      "id": "pbCstop",
      "type": "pushbutton",
      "label": "CYCLE STOP",
      "params": { "kind": "momentary", "color": "yellow", "lamp": false },
      "io": { "pb": "PB_CSTOP" }
    },
    {
      "id": "pbHome",
      "type": "pushbutton",
      "label": "HOME POS",
      "params": { "kind": "momentary", "color": "blue", "lamp": true },
      "io": { "pb": "PB_HOME", "lamp": "PL_HOME" }
    },
    {
      "id": "lampAuto",
      "type": "lamp",
      "label": "AUTO",
      "params": { "color": "amber" },
      "io": { "lamp": "AUTO_RUN" }
    },
    {
      "id": "dialOvr",
      "type": "speedDial",
      "label": "SPEED",
      "params": { "min": 10 },
      "io": { "ovr": "OVR_SET" }
    },
    {
      "id": "pbIndCv1",
      "type": "pushbutton",
      "label": "IND INFEED BELT",
      "params": { "kind": "momentary", "color": "blue", "lamp": true },
      "io": { "pb": "IND_CV1", "lamp": "CV1_RUN" }
    },
    {
      "id": "pbIndCv2",
      "type": "pushbutton",
      "label": "IND OUTFEED BELT",
      "params": { "kind": "momentary", "color": "blue", "lamp": true },
      "io": { "pb": "IND_CV2", "lamp": "CV2_RUN" }
    },
    {
      "id": "pbIndFeed",
      "type": "pushbutton",
      "label": "IND FEED",
      "params": { "kind": "momentary", "color": "yellow", "lamp": false },
      "io": { "pb": "IND_FEED" }
    },
    {
      "id": "pbIndLift",
      "type": "pushbutton",
      "label": "IND LIFT DOWN",
      "params": { "kind": "momentary", "color": "white", "lamp": true },
      "io": { "pb": "IND_LIFT", "lamp": "SOL_Z_DN" }
    },
    {
      "id": "pbIndTrav",
      "type": "pushbutton",
      "label": "IND TRAVERSE OUT",
      "params": { "kind": "momentary", "color": "white", "lamp": true },
      "io": { "pb": "IND_TRAV", "lamp": "SOL_Y_OUT" }
    },
    {
      "id": "pbIndGrip",
      "type": "pushbutton",
      "label": "IND GRIP",
      "params": { "kind": "momentary", "color": "white", "lamp": true },
      "io": { "pb": "IND_GRIP", "lamp": "GRIP_CLOSE" }
    }
  ]
}
