{
  "format": "mio-scene/1",
  "name": "press-station",
  "sim": { "dtMs": 2 },
  "io": {
    "driver": "opcua",
    "endpoint": "opc.tcp://127.0.0.1:4840",
    "prefix": "GlobalVars.",
    "mode": "sim",
    "minPulseMs": 20
  },
  "stations": [
    { "id": "ST1", "name": "Press", "members": ["nest1", "press", "eject"], "stepTag": "ST1_STEP" }
  ],
  "cycle": {
    "exitTag": "NEST_P",
    "autoTag": "AUTO_RUN",
    "countTag": "CYCLE_CNT",
    "exclude": 1,
    "avgN": 10
  },
  "components": [
    {
      "id": "pedestal",
      "type": "plate",
      "label": "PEDESTAL",
      "at": [0, 0, 0],
      "params": { "size": [80, 120, 800] }
    },
    {
      "id": "nest1",
      "type": "nest",
      "label": "PRESS NEST",
      "station": "ST1",
      "parent": "pedestal",
      "socket": "top",
      "at": [0, 0, 0],
      "params": { "size": [80, 60, 22], "wall": 6 },
      "io": { "clamp": "CLAMP", "present": "NEST_P" }
    },
    {
      "id": "wp",
      "type": "workpiece",
      "label": "PART TEMPLATE",
      "at": [0, -600, 0],
      "params": { "size": [60, 40, 40], "color": "#27b045", "material": "alu" }
    },
    {
      "id": "em1",
      "type": "emitter",
      "label": "FEEDER",
      "parent": "nest1",
      "socket": "top",
      "at": [0, 0, 100],
      "params": { "template": "wp", "mode": "tag" },
      "io": { "emit": "EM_EMIT", "count": "EM_CNT" }
    },
    {
      "id": "col",
      "type": "plate",
      "label": "PRESS COLUMN",
      "at": [-260, 0, 0],
      "params": { "size": [80, 80, 1240] }
    },
    {
      "id": "beam",
      "type": "plate",
      "label": "PRESS BEAM",
      "at": [-130, 0, 1240],
      "params": { "size": [340, 80, 40] }
    },
    {
      "id": "press",
      "type": "cylinder",
      "label": "PRESS",
      "station": "ST1",
      "at": [0, 0, 1240],
      "rot": [180, 0, 0],
      "params": {
        "bore": 40,
        "stroke": 150,
        "valve": "5/2-double",
        "extendMs": 600,
        "retractMs": 500,
        "extWord": "DOWN",
        "retWord": "UP",
        "head": "plate",
        "headSize": [70, 50, 10]
      },
      "io": { "solExt": "SOL_P_DN", "solRet": "SOL_P_UP", "sw.ret": "AS_P_UP", "sw.ext": "AS_P_DN" }
    },
    {
      "id": "ejPost",
      "type": "plate",
      "label": "EJECTOR STAND",
      "at": [-165, 0, 0],
      "params": { "size": [50, 50, 815] }
    },
    {
      "id": "eject",
      "type": "cylinder",
      "label": "EJECTOR",
      "station": "ST1",
      "at": [-245, 0, 831],
      "rot": [0, 90, 0],
      "params": {
        "bore": 20,
        "stroke": 120,
        "valve": "5/2-single",
        "extendMs": 300,
        "retractMs": 300,
        "extWord": "OUT",
        "retWord": "BACK",
        "head": "plate",
        "headSize": [14, 50, 8]
      },
      "io": { "solExt": "SOL_EJECT", "sw.ret": "AS_EJ_BACK", "sw.ext": "AS_EJ_OUT" }
    },
    {
      "id": "chute",
      "type": "plate",
      "label": "UNLOAD CHUTE",
      "at": [230, 0, 650],
      "rot": [0, 35, 0],
      "params": { "size": [400, 200, 10] }
    },
    {
      "id": "rm1",
      "type": "remover",
      "label": "UNLOAD BIN",
      "at": [550, 0, 80],
      "params": { "size": [400, 400, 400] },
      "io": { "count": "RM_CNT" }
    },
    { "id": "sel", "type": "selector", "label": "AUTO / INDIVIDUAL", "io": { "sel": "SEL_AUTO" } },
    {
      "id": "pbMaster",
      "type": "pushbutton",
      "label": "MASTER ON",
      "params": { "kind": "momentary", "color": "white", "lamp": true },
      "io": { "pb": "PB_MASTER", "lamp": "PL_MASTER" }
    },
    {
      "id": "pbEstop",
      "type": "pushbutton",
      "label": "EMERGENCY STOP",
      "params": { "kind": "alternate", "color": "red", "lamp": false },
      "io": { "pb": "PB_ESTOP" }
    },
    {
      "id": "pbStart",
      "type": "pushbutton",
      "label": "START",
      "params": { "kind": "momentary", "color": "green", "lamp": true },
      "io": { "pb": "PB_START", "lamp": "PL_START" }
    },
    {
      "id": "pbCstop",
      "type": "pushbutton",
      "label": "CYCLE STOP",
      "params": { "kind": "momentary", "color": "yellow", "lamp": false },
      "io": { "pb": "PB_CSTOP" }
    },
    {
      "id": "pbHome",
      "type": "pushbutton",
      "label": "HOME POS",
      "params": { "kind": "momentary", "color": "blue", "lamp": true },
      "io": { "pb": "PB_HOME", "lamp": "PL_HOME" }
    },
    {
      "id": "lampAuto",
      "type": "lamp",
      "label": "AUTO",
      "params": { "color": "amber" },
      "io": { "lamp": "AUTO_RUN" }
    },
    {
      "id": "pbIndFeed",
      "type": "pushbutton",
      "label": "IND FEED",
      "params": { "kind": "momentary", "color": "yellow", "lamp": false },
      "io": { "pb": "IND_FEED" }
    },
    {
      "id": "pbIndClamp",
      "type": "pushbutton",
      "label": "IND CLAMP",
      "params": { "kind": "momentary", "color": "white", "lamp": true },
      "io": { "pb": "IND_CLAMP", "lamp": "CLAMP" }
    },
    {
      "id": "pbIndPress",
      "type": "pushbutton",
      "label": "IND PRESS",
      "params": { "kind": "momentary", "color": "white", "lamp": true },
      "io": { "pb": "IND_PRESS", "lamp": "SOL_P_DN" }
    },
    {
      "id": "pbIndEject",
      "type": "pushbutton",
      "label": "IND EJECT",
      "params": { "kind": "momentary", "color": "white", "lamp": true },
      "io": { "pb": "IND_EJECT", "lamp": "SOL_EJECT" }
    }
  ]
}
