{
  "format": "mio-scene/1",
  "name": "sort-by-material",
  "sim": { "dtMs": 2 },
  "io": {
    "driver": "opcua",
    "endpoint": "opc.tcp://127.0.0.1:4840",
    "prefix": "GlobalVars.",
    "mode": "sim",
    "minPulseMs": 20
  },
  "stations": [
    {
      "id": "ST1",
      "name": "Sort by material",
      "members": ["cv1", "px1", "pe1", "psh"],
      "stepTag": "ST1_STEP"
    }
  ],
  "cycle": {
    "exitTag": "PE_STOP",
    "autoTag": "AUTO_RUN",
    "countTag": "CYCLE_CNT",
    "exclude": 1,
    "avgN": 10
  },
  "components": [
    {
      "id": "cv1",
      "type": "conveyor",
      "label": "SORT BELT",
      "station": "ST1",
      "params": { "length": 2400, "width": 200, "height": 800, "speed": 300, "guides": 0 },
      "io": { "run": "CV_RUN", "ovr": "OVR" }
    },
    {
      "id": "wpSteel",
      "type": "workpiece",
      "label": "STEEL TEMPLATE",
      "at": [0, 1200, 0],
      "params": { "size": [60, 40, 30], "color": "#8a939c", "material": "steel" }
    },
    {
      "id": "wpPlastic",
      "type": "workpiece",
      "label": "PLASTIC TEMPLATE",
      "at": [200, 1200, 0],
      "params": { "size": [60, 40, 30], "color": "#2a6fdb", "material": "plastic" }
    },
    {
      "id": "emSteel",
      "type": "emitter",
      "label": "STEEL FEEDER",
      "parent": "cv1",
      "socket": "start",
      "at": [100, 0, 60],
      "params": { "template": "wpSteel", "mode": "tag" },
      "io": { "emit": "EM_M_EMIT", "count": "EM_M_CNT" }
    },
    {
      "id": "emPlastic",
      "type": "emitter",
      "label": "PLASTIC FEEDER",
      "parent": "cv1",
      "socket": "start",
      "at": [300, 0, 60],
      "params": { "template": "wpPlastic", "mode": "tag" },
      "io": { "emit": "EM_P_EMIT", "count": "EM_P_CNT" }
    },
    {
      "id": "px1",
      "type": "proximity",
      "label": "METAL DETECT",
      "station": "ST1",
      "parent": "cv1",
      "socket": "top",
      "at": [400, -26, 15],
      "rot": [0, 0, 90],
      "params": { "range": 16, "metalOnly": true },
      "io": { "out": "PX_METAL" }
    },
    {
      "id": "pe1",
      "type": "photoEye",
      "label": "STOP SENSOR",
      "station": "ST1",
      "parent": "cv1",
      "socket": "top",
      "at": [700, -140, 12],
      "rot": [0, 0, 90],
      "params": { "range": 300 },
      "io": { "out": "PE_STOP" }
    },
    {
      "id": "pst",
      "type": "plate",
      "parent": "cv1",
      "socket": "top",
      "at": [690, 300, -800],
      "params": { "size": [50, 50, 800] }
    },
    {
      "id": "psh",
      "type": "cylinder",
      "label": "METAL PUSHER",
      "station": "ST1",
      "parent": "cv1",
      "socket": "top",
      "at": [690, 440, 30],
      "rot": [90, 0, 0],
      "params": {
        "bore": 25,
        "stroke": 250,
        "valve": "5/2-single",
        "extendMs": 700,
        "retractMs": 500,
        "extWord": "PUSH",
        "retWord": "BACK",
        "head": "plate",
        "headSize": [100, 60, 8]
      },
      "io": { "solExt": "SOL_PUSH", "sw.ret": "AS_PUSH_RET", "sw.ext": "AS_PUSH_EXT" }
    },
    {
      "id": "chute",
      "type": "plate",
      "label": "METAL CHUTE",
      "parent": "cv1",
      "socket": "top",
      "at": [690, -273, -138],
      "rot": [35, 0, 0],
      "params": { "size": [300, 400, 10] }
    },
    {
      "id": "rmMetal",
      "type": "remover",
      "label": "METAL BIN",
      "parent": "cv1",
      "socket": "top",
      "at": [690, -700, -800],
      "params": { "size": [400, 600, 400] },
      "io": { "count": "RM_M_CNT" }
    },
    {
      "id": "rmPlastic",
      "type": "remover",
      "label": "OUTFEED",
      "parent": "cv1",
      "socket": "end",
      "at": [-60, 0, 0],
      "params": { "size": [120, 260, 200] },
      "io": { "count": "RM_P_CNT" }
    },
    { "id": "sel", "type": "selector", "label": "AUTO / INDIVIDUAL", "io": { "sel": "SEL_AUTO" } },
    {
      "id": "pbMaster",
      "type": "pushbutton",
      "label": "MASTER ON",
      "params": { "kind": "momentary", "color": "white", "lamp": true },
      "io": { "pb": "PB_MASTER", "lamp": "PL_MASTER" }
    },
    {
      "id": "pbEstop",
      "type": "pushbutton",
      "label": "EMERGENCY STOP",
      "params": { "kind": "alternate", "color": "red", "lamp": false },
      "io": { "pb": "PB_ESTOP" }
    },
    {
      "id": "pbStart",
      "type": "pushbutton",
      "label": "START",
      "params": { "kind": "momentary", "color": "green", "lamp": true },
      "io": { "pb": "PB_START", "lamp": "PL_START" }
    },
    {
      "id": "pbCstop",
      "type": "pushbutton",
      "label": "CYCLE STOP",
      "params": { "kind": "momentary", "color": "yellow", "lamp": false },
      "io": { "pb": "PB_CSTOP" }
    },
    {
      "id": "pbHome",
      "type": "pushbutton",
      "label": "HOME POS",
      "params": { "kind": "momentary", "color": "blue", "lamp": true },
      "io": { "pb": "PB_HOME", "lamp": "PL_HOME" }
    },
    {
      "id": "lampAuto",
      "type": "lamp",
      "label": "AUTO",
      "params": { "color": "amber" },
      "io": { "lamp": "AUTO_RUN" }
    },
    {
      "id": "dialOvr",
      "type": "speedDial",
      "label": "SPEED",
      "params": { "min": 10 },
      "io": { "ovr": "OVR_SET" }
    },
    {
      "id": "pbIndCv",
      "type": "pushbutton",
      "label": "IND BELT",
      "params": { "kind": "momentary", "color": "blue", "lamp": true },
      "io": { "pb": "IND_CV", "lamp": "CV_RUN" }
    },
    {
      "id": "pbIndFeedM",
      "type": "pushbutton",
      "label": "IND FEED STEEL",
      "params": { "kind": "momentary", "color": "yellow", "lamp": false },
      "io": { "pb": "IND_FEED_M" }
    },
    {
      "id": "pbIndFeedP",
      "type": "pushbutton",
      "label": "IND FEED PLASTIC",
      "params": { "kind": "momentary", "color": "yellow", "lamp": false },
      "io": { "pb": "IND_FEED_P" }
    },
    {
      "id": "pbIndPush",
      "type": "pushbutton",
      "label": "IND PUSHER",
      "params": { "kind": "momentary", "color": "white", "lamp": true },
      "io": { "pb": "IND_PUSH", "lamp": "SOL_PUSH" }
    }
  ]
}
