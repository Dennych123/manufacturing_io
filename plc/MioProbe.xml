  <Types>
    <GlobalNamespace>
      <Program name="PRG_MIO_PROBE">
        <ExternalVars>
          <Variable name="MIO_HEARTBEAT">
            <Type><TypeName>UDINT</TypeName></Type>
          </Variable>
          <Variable name="MIO_ECHO_IN">
            <Type><TypeName>DINT</TypeName></Type>
          </Variable>
          <Variable name="MIO_ECHO_OUT">
            <Type><TypeName>DINT</TypeName></Type>
          </Variable>
          <Variable name="MIO_PULSE_IN">
            <Type><TypeName>BOOL</TypeName></Type>
          </Variable>
          <Variable name="MIO_PULSE_CNT">
            <Type><TypeName>UDINT</TypeName></Type>
          </Variable>
        </ExternalVars>
        <Vars accessSpecifier="private">
          <Variable name="PULSE_LAST">
            <Type><TypeName>BOOL</TypeName></Type>
          </Variable>
        </Vars>
        <MainBody>
          <BodyContent xsi:type="ST">
            <ST>// Generated by manufacturing_io tools/gen_sysmac.js --probe. Regenerate, do not edit.

// Heartbeat: if this does not move, the program is not assigned to a task.
MIO_HEARTBEAT := MIO_HEARTBEAT + 1;

// Echo: the plant writes MIO_ECHO_IN; the time until MIO_ECHO_OUT follows is the round trip.
MIO_ECHO_OUT := MIO_ECHO_IN;

// Pulse counter: a pulse the PLC saw is counted, so it cannot be lost to OPC UA sampling.
IF MIO_PULSE_IN AND NOT PULSE_LAST THEN
	MIO_PULSE_CNT := MIO_PULSE_CNT + 1;
END_IF;
PULSE_LAST := MIO_PULSE_IN;</ST>
          </BodyContent>
        </MainBody>
      </Program>
    </GlobalNamespace>
